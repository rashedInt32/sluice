#!/usr/bin/env bash
# rex-sessions — sluice's session picker, over Rex sessions instead of zmx
# ones. Rex runs it in a floating layer on prefix+f, through
# ~/.config/rex/bin/rex-pick, which switches the app to the pick.
#
#   rex-sessions          fzf picker; prints the chosen session's id
#   rex-sessions --list   print the rows only (fzf's reload)
#
# Rows are numbered in session-id order, the order Rex's prefix+1..9 jump
# uses, so a number means the same session in both. Below the list is the
# screen of the session's focused pane, from `rex capture`.
#
# Same nav keys and look as sluice's own picker: j/k move, 1-9 or enter
# jump, ctrl-x closes a session (never the one you are in), i or / search,
# q or esc back out.
#
# $SLUICE_REX_HIDE names a session to leave off the list: the throwaway one
# rex-pick runs in when no session is open. $SLUICE_REX_FROM is the pane the
# key was pressed in, previewed for the session you are in.
set -uo pipefail
case "${BASH_SOURCE[0]}" in
  */*) DIR="${BASH_SOURCE[0]%/*}" ;;
  *) DIR=. ;;
esac
[[ "$DIR" == /* ]] || DIR="$PWD/$DIR"

REXCLI=${REX_BIN:-rex}
command -v "$REXCLI" >/dev/null 2>&1 ||
  REXCLI="$HOME/Library/Application Support/com.superlogical.rex/RexServer/Versions/Current/Rex Server.app/Contents/MacOS/rex"
export REXCLI

# One session's fields, tab-separated: id, label, windows, focused block,
# what that block runs, its directory. Control characters become _ so a
# label cannot paint over the list.
row() {
  local id=$1 info blk proc
  info=$("$REXCLI" session inspect "$id" --json 2>/dev/null) || return
  blk=$(jq -r '(.active_window_id) as $a | (.windows[] | select(.window_id == $a) | .focused_block_id) // (.windows[0].focused_block_id // "")' <<<"$info")
  # In the session you are in, the focused pane is this picker's own layer:
  # use the pane the key was pressed in, or show no screen rather than ours.
  if [[ "$id" == "${REX_SESSION:-}" ]]; then
    if [[ -n "${SLUICE_REX_FROM:-}" ]]; then
      blk=$SLUICE_REX_FROM
    elif [[ "$blk" == "${REX_BLOCK:-}" ]]; then
      blk=""
    fi
  fi
  proc='{}'
  [[ -n "$blk" ]] && proc=$("$REXCLI" block call -s "$id" -b "$blk" process 2>/dev/null || echo '{}')
  jq -rn --argjson s "$info" --argjson p "$proc" --arg b "$blk" --arg home "$HOME" '
    def clean: gsub("[\u0000-\u001f\u007f]"; "_");
    [ $s.session_id,
      ($s.label // "" | clean),
      ($s.windows | length | tostring),
      $b,
      # Claude Code runs as a binary named for its version (2.1.316): show
      # the name it was started by instead.
      (($p.foreground // $p.child // {}) as $f
        | (if ($f.name // "") | test("^[0-9][0-9.]*$") then ($f.argv0 // $f.name | sub(".*/"; "")) else ($f.name // "") end)
        | clean),
      ($p.foreground.cwd // $p.child.cwd // "" | clean
        | if startswith($home) then "~" + .[($home | length):] else . end)
    ] | @tsv'
}

list() {
  local ids tmp i=0
  ids=$("$REXCLI" ls --json 2>/dev/null | jq -r --arg hide "${SLUICE_REX_HIDE:-}" \
    '.sessions | sort_by(.session_id) | .[] | select(.session_id != $hide) | .session_id') || return 1
  [[ -z "$ids" ]] && return 0
  tmp=$(mktemp -d) || return 1
  # Two CLI calls per session, ~20 ms each: run the sessions side by side.
  while IFS= read -r id; do
    i=$((i + 1))
    row "$id" >"$tmp/$i" &
  done <<<"$ids"
  wait
  for ((n = 1; n <= i; n++)); do cat "$tmp/$n"; done | paint
  rm -rf "$tmp"
}

# sluice's prism colours (src/picker.rs), padded before painting so the
# columns line up. Shown: number, mark, label, windows, program, directory.
# Hidden after the shown text: session id, block id.
paint() {
  awk -F'\t' -v cur="${REX_SESSION:-}" '
    function c(hex, s) {
      return sprintf("\033[38;2;%d;%d;%dm%s\033[0m",
        h(substr(hex, 2, 2)), h(substr(hex, 4, 2)), h(substr(hex, 6, 2)), s)
    }
    function h(x,   i, v) {
      v = 0
      for (i = 1; i <= 2; i++) v = v * 16 + index("0123456789abcdef", tolower(substr(x, i, 1))) - 1
      return v
    }
    { id[NR] = $1; lb[NR] = $2; w[NR] = $3; blk[NR] = $4; pr[NR] = $5; cwd[NR] = $6
      if (length($2) > lw) lw = length($2)
      if (length($5) > pw) pw = length($5) }
    END {
      if (lw < 4) lw = 4
      for (r = 1; r <= NR; r++) {
        n = r <= 9 ? r : " "
        mark = id[r] == cur ? c("#32ff7e", "●") : " "
        wins = w[r] > 1 ? w[r] "w" : ""
        printf "%s %s %s  %s  %s  %s\t%s\t%s\n", c("#8a8a8a", n), mark,
          c("#dcdcdc", sprintf("%-" lw "s", lb[r])), c("#9a9a9a", sprintf("%-3s", wins)),
          c("#4d96ff", sprintf("%-" pw "s", pr[r])), c("#9a9a9a", cwd[r]), id[r], blk[r]
      }
    }'
}

[ "${1:-}" = '--list' ] && { list; exit; }

for tool in fzf jq; do
  command -v "$tool" >/dev/null 2>&1 || {
    echo "rex-sessions: $tool is required" >&2
    sleep 1.5
    exit 1
  }
done

style_words="$("${SLUICE:-sluice}" picker-style --preview --label 'rex sessions' \
  --hints 'j/k move · 1-9/enter jump · ctrl-x close · i search · q back')" || {
  echo "rex-sessions: needs a sluice with picker-style on PATH" >&2
  sleep 1.5
  exit 1
}
eval "style=($style_words)"

rows=$(list)
if [[ -z "$rows" ]]; then
  echo "rex-sessions: no Rex sessions" >&2
  sleep 1.2
  exit 1
fi
# The cursor starts on the session you are in, as in sluice.
here=$(awk -F'\t' -v cur="${REX_SESSION:-}" '$2 == cur { print NR; exit }' <<<"$rows")
start=()
[[ -n "$here" ]] && start=(--sync --track "--bind=start:pos($here)")

# {2} and {3} reach sh already quoted by fzf, so a label never becomes code.
# No frame or margin of our own: the Rex layer already pads the panel, and
# rex-pick's default fzf border would nest a third box around sluice's two.
sel=$(fzf "${style[@]}" "${start[@]}" \
  --border=none --margin=0 --padding=0 \
  --delimiter=$'\t' --with-nth=1 \
  --preview='"$REXCLI" capture -s {2} -b {3} --format=vt --trim 2>/dev/null | tr -d "\r" | tail -n 400' \
  --bind="ctrl-x:execute-silent([ {2} = \"\${REX_SESSION:-}\" ] || \"\$REXCLI\" kill {2} >/dev/null 2>&1)+reload('$DIR/rex-sessions' --list)" \
  --bind="ctrl-l:reload('$DIR/rex-sessions' --list)" <<<"$rows") || exit 1

printf '%s\n' "$sel" | cut -f2
