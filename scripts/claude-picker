#!/usr/bin/env bash
# claude-picker — every running Claude Code agent on this machine, and the zmx
# session it lives in. Bound to prefix+u.
#
#   claude-picker          fzf picker; prints the chosen agent's session, which
#                          sluice then attaches this pane to.
#   claude-picker --list   print the rows only (used by fzf's ctrl-x reload).
#
# An agent inside nvim shows up like any other: it inherits ZMX_SESSION from
# the session hosting the editor, so jumping to it puts you in that pane.
#
# Opens in vim-style nav mode, like sluice's own pickers: j/k move, enter
# jumps, ctrl-x kills the agent, i or / drops into search, q or esc backs out.
set -uo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

[ "${1:-}" = '--list' ] && exec "$DIR/agents"

for tool in fzf jq zmx; do
  command -v "$tool" >/dev/null 2>&1 || {
    echo "claude-picker: $tool is required" >&2
    sleep 1.5
    exit 1
  }
done

# The agent scan costs ~40ms, most of it one `ps` over every agent's
# environment. Rather than make the window wait for it, fzf is started on an
# empty list and fills itself from `start:reload`: the frame is on screen in
# the time fzf itself takes, and the rows arrive into it.
#
# Columns 5.. are shown, painted; 1..4 are the sort keys and the plain session
# and pid, and stay hidden. The chosen session is read back out of column 2.
#
# The look is sluice's own picker (src/picker.rs) with one change: prism's
# purple where the session picker has orange, so the two never read as one.
# Hex values are copied from picker.rs; keep them in step.
nav='j,k,q,i,a,/'
purple=$'\e[1;38;2;140;111;240m' faint=$'\e[38;2;108;108;108m'
blue=$'\e[1;38;2;77;150;255m' reset=$'\e[0m'
label=' ✻ agents '
hint() { printf '%s%s%s %s%s%s' "$blue" "$1" "$reset" "$faint" "$2" "$reset"; }
footer="$(hint j/k move)  $(hint enter jump)  $(hint ctrl-x kill)  $(hint i search)  $(hint q back)"
to_search="unbind($nav)+change-prompt(${purple}/ ${reset})+change-input-label( ${purple}search${reset} )+change-list-label(${faint}${label}${reset})+change-ghost()"
to_nav="rebind($nav)+change-prompt(❯ )+change-input-label()+change-list-label($label)+change-ghost(i search)"
sel="$(fzf </dev/null \
  --bind="start:reload('$DIR/agents')" \
  --delimiter=$'\t' --with-nth='5..' --ansi \
  --layout=reverse --no-sort --cycle --info=inline-right --tiebreak=index \
  --margin=1,2 --input-border=rounded --list-border=rounded \
  --highlight-line --pointer='▌' --gutter=' ' --ghost='i search' \
  --color='bg+:#0e2a3a,fg+:#ffffff:bold,gutter:-1,pointer:#8c6ff0' \
  --color='list-border:#8c6ff0,list-label:#8c6ff0:bold' \
  --color='input-border:#6c6c6c,input-label:#6c6c6c,prompt:#6c6c6c' \
  --color='preview-border:#565656,preview-label:#8a8a8a' \
  --color='query:#dcdcdc,ghost:#565656,info:#9a9a9a,hl:#4eb4d3,hl+:#4eb4d3:bold' \
  --prompt='❯ ' --list-label="$label" \
  --footer="$footer" --footer-border=inline \
  --preview='zmx history {2} --vt --screen' \
  --preview-window='down,50%,border-rounded' \
  --bind="focus:transform-preview-label:printf ' %s ' {2}" \
  --bind='j:down' --bind='k:up' --bind='q:abort' \
  --bind="i:$to_search" --bind="a:$to_search" --bind="/:$to_search" \
  --bind="esc:transform:[ \"\$FZF_PROMPT\" = '❯ ' ] && echo abort || echo \"$to_nav\"" \
  --bind="ctrl-x:execute-silent(kill {3})+reload(sleep 0.4; '$DIR/claude-picker' --list)" \
  --bind="ctrl-l:reload('$DIR/claude-picker' --list)")"

# Nothing chosen: either the list was empty or the picker was dismissed. Only
# the empty case is worth a word, and it is cheap to check once, afterwards.
if [ -z "$sel" ]; then
  if [ -z "$("$DIR/agents")" ]; then
    echo "claude-picker: no Claude agents are running in a zmx session" >&2
    sleep 1.2
  fi
  exit 1
fi

# Hand the window back to sluice, which attaches this pane to it. The agent
# lives in one specific window, so name it explicitly: a bare session name
# would send sluice to whichever window of that session was shown last.
# Window 1 has no suffix of its own, so it is spelled `<session>+1`.
win="$(printf '%s\n' "$sel" | cut -f2)"
case "$win" in
  *+[0-9]*) printf '%s\n' "$win" ;;
  *) printf '%s+1\n' "$win" ;;
esac
