#!/usr/bin/env bash
# claude-picker — every running Claude Code agent on this machine, and the zmx
# session it lives in. Bound to prefix+u.
#
#   claude-picker          fzf picker; prints the chosen agent's session, which
#                          sluice then attaches this pane to.
#   claude-picker --list   print the rows only (used by fzf's ctrl-x reload).
#
# An agent inside nvim shows up like any other: it inherits ZMX_SESSION from
# the session hosting the editor, so jumping to it puts you in that pane.
#
# Opens in vim-style nav mode, like sluice's own pickers: j/k move, 1-9 or
# enter jump, ctrl-x kills the agent, i or / drops into search, q or esc backs
# out.
set -uo pipefail
# This script's folder, without the two subshells and the dirname a
# `$(cd "$(dirname ...)" && pwd)` costs on every prefix+u.
case "${BASH_SOURCE[0]}" in
  */*) DIR="${BASH_SOURCE[0]%/*}" ;;
  *) DIR=. ;;
esac
[[ "$DIR" == /* ]] || DIR="$PWD/$DIR"

[ "${1:-}" = '--list' ] && exec "$DIR/agents"

for tool in fzf jq zmx; do
  command -v "$tool" >/dev/null 2>&1 || {
    echo "claude-picker: $tool is required" >&2
    sleep 1.5
    exit 1
  }
done

# The agent scan costs ~40ms, most of it one `ps` over every agent's
# environment. Rather than make the window wait for it, fzf is started on an
# empty list and fills itself from `start:reload`: the frame is on screen in
# the time fzf itself takes, and the rows arrive into it.
#
# Columns 5.. are shown, painted; 1..4 are the sort keys and the plain session
# and pid, and stay hidden. The chosen session is read back out of column 2.
#
# The look and the nav keys come from sluice itself (`sluice picker-style`),
# so this picker cannot drift from the session picker. One change: prism's
# purple where the session picker has orange, so the two never read as one.
# sluice sets $SLUICE to its own binary when it runs this script.
style_words="$("${SLUICE:-sluice}" picker-style --preview --label '✻ agents' --accent '#8c6ff0' \
  --hints 'j/k move · 1-9/enter jump · ctrl-x kill · i search · q back')" || {
  echo "claude-picker: needs a sluice with picker-style on PATH" >&2
  sleep 1.5
  exit 1
}
# Every word arrives shell-quoted by sluice, so eval only rebuilds the array.
eval "style=($style_words)"
# Under sluice ($SLUICE set) the picker stays drawn when fzf exits, and
# sluice swaps it for the session in one frame.
sel="$(fzf </dev/null "${style[@]}" ${SLUICE:+--no-clear} \
  --bind="start:reload('$DIR/agents')" \
  --delimiter=$'\t' --with-nth='5..' \
  --preview='zmx history {s2} --vt' \
  --bind="focus:transform-preview-label:printf ' %s ' {s2}" \
  --bind="ctrl-x:execute-silent(kill {3})+reload(sleep 0.4; '$DIR/claude-picker' --list)" \
  --bind="ctrl-l:reload('$DIR/claude-picker' --list)")"

# Nothing chosen: either the list was empty or the picker was dismissed. Only
# the empty case is worth a word, and it is cheap to check once, afterwards.
if [ -z "$sel" ]; then
  if [ -z "$("$DIR/agents")" ]; then
    # off the picker's frame, so the message is not drawn over it
    [ -n "${SLUICE:-}" ] && printf '\033[?1049l' >/dev/tty
    echo "claude-picker: no Claude agents are running in a zmx session" >&2
    sleep 1.2
  fi
  exit 1
fi

# Hand the window back to sluice, which attaches this pane to it. The agent
# lives in one specific window, so name it explicitly: a bare session name
# would send sluice to whichever window of that session was shown last.
# Window 1 has no suffix of its own, so it is spelled `<session>+1`.
win="$(printf '%s\n' "$sel" | cut -f2)"
# Only a trailing +<n> as sluice writes it is a window: `c++17-tools` is a
# session name.
if [[ "$win" =~ \+[1-9][0-9]{0,3}$ ]]; then
  printf '%s\n' "$win"
else
  printf '%s+1\n' "$win"
fi
