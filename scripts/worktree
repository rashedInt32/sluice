#!/usr/bin/env bash
# worktree — git worktrees as sluice sessions (port of tmux-worktree).
#
# Run inside a git repo. fzf lists, in one picker:
#   ● branch   -> an existing worktree      -> switch to its session
#   + branch   -> a branch with no worktree -> create a worktree for it, then switch
#   type name  -> no match                  -> new branch + worktree, then switch
# Prints "<session>\t<path>" for sluice; one worktree = one branch = one session.
# A detached worktree has no branch: its directory name stands in for one.
#
# The repo is taken from $PWD, which for sluice is the directory the picker was
# started from: set SLUICE_REPO to override.

repo_root=$(git -C "${SLUICE_REPO:-$PWD}" rev-parse --show-toplevel 2>/dev/null)
if [[ -z "$repo_root" ]]; then
  echo "worktree: not inside a git repository" >&2; sleep 1.5; exit 1
fi
repo_name=$(basename "$repo_root")
wt_base="$HOME/.worktrees/$repo_name"

wt_porcelain=$(git -C "$repo_root" worktree list --porcelain)

wt_rows=$(printf '%s\n' "$wt_porcelain" | awk '
  /^worktree /{p=substr($0,10)}
  /^branch /{b=$2; sub("refs/heads/","",b); print "● "b"\t"b"\t"p}
  /^detached$/{n=split(p,d,"/"); b="(detached "d[n]")"; print "● "b"\t"b"\t"p}
')
wt_branches=$(printf '%s\n' "$wt_porcelain" | awk '
  /^branch /{b=$2; sub("refs/heads/","",b); print b}')
# The list goes in through the environment: macOS awk refuses a newline in -v.
branch_rows=$(git -C "$repo_root" for-each-ref --format='%(refname:short)' refs/heads \
  | have="$wt_branches" awk '
      BEGIN{ n=split(ENVIRON["have"], a, "\n"); for (i=1;i<=n;i++) seen[a[i]]=1 }
      { if (!seen[$0]) print "+ "$0"\t"$0"\t" }')

list=$(printf '%s\n%s\n' "$wt_rows" "$branch_rows" | sed '/^$/d')

# Under sluice ($SLUICE set) the picker stays drawn when fzf exits, and
# sluice swaps it for the session in one frame. An error leaves it first.
sel=$(printf '%s\n' "$list" \
  | fzf --with-nth=1 --delimiter=$'\t' --print-query ${SLUICE:+--no-clear} \
        --prompt='worktree > ' \
        --header='● switch · + create worktree for branch · type a new name = new branch')

query=$(printf '%s\n' "$sel" | sed -n '1p')
match=$(printf '%s\n' "$sel" | sed -n '2p')
# git's own output goes to $err too: it prints "HEAD is now at ..." on stdout,
# and sluice reads the first line of stdout as the session to open.
err=$(mktemp)
fail() {
  [ -n "${SLUICE:-}" ] && printf '\033[?1049l' >/dev/tty
  echo "failed to create worktree:" >&2; cat "$err" >&2; sleep 2.5; exit 1
}

if [[ -n "$match" ]]; then
  branch=$(printf '%s' "$match" | cut -f2)
  path=$(printf '%s' "$match" | cut -f3)
  if [[ -z "$path" ]]; then
    path="$wt_base/$branch"
    if [[ ! -d "$path" ]]; then
      git -C "$repo_root" worktree add "$path" "$branch" >"$err" 2>&1 || fail
    fi
  fi
else
  branch="$query"
  [[ -z "$branch" ]] && exit 1
  path="$wt_base/$branch"
  if ! git -C "$repo_root" worktree add "$path" -b "$branch" >"$err" 2>&1; then
    git -C "$repo_root" worktree add "$path" "$branch" >>"$err" 2>&1 || fail
  fi
fi
rm -f "$err"

[[ -z "$path" || ! -d "$path" ]] && exit 1
label=$branch
# Detached worktrees can share a directory name (a/build, b/build): a short
# hash of the path keeps their sessions apart.
if [[ "$branch" == "(detached "* ]]; then
  label="detached-$(basename "$path")-$(printf '%s' "$path" | cksum | cut -d' ' -f1 | tail -c 5)"
fi
session=$(printf '%s' "${repo_name}/${label}" | tr './:, ' '_____')
# A trailing +<digits> would read as a window of another session.
[[ "$session" =~ ^(.+)\+([0-9]+)$ ]] && session="${BASH_REMATCH[1]}_${BASH_REMATCH[2]}"
printf '%s\t%s\n' "$session" "$path"
