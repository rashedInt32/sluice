#!/usr/bin/env bash
# sessionizer — pick a project directory, print "<session>\t<dir>" for sluice.
# Same list and fzf feel as tmux-sessionizer; only the last lines differ.
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

# Under sluice ($SLUICE set) the picker stays drawn when fzf exits, and
# sluice swaps it for the session in one frame. Run by hand, fzf clears up.
selected=$("$here/project-dirs" \
  | fzf --with-nth=1 --delimiter="\t" --ansi --prompt='project > ' ${SLUICE:+--no-clear} \
  | cut -d$'\t' -f2 | sed 's/[[:space:]]*$//')

[[ -z "$selected" || ! -d "$selected" ]] && exit 1

if [[ "$selected" == "$HOME/.worktrees/"* ]]; then
  # Same name shape the worktree picker uses, so both land on one session.
  name=$(printf '%s' "${selected#"$HOME"/.worktrees/}" | tr './:, ' '_____')
else
  name=$(basename "$selected" | tr ".,: " "____")
fi
# A trailing +<digits> would read as a window of another session: c++17 is
# window 17 of `c+`. Same rule as sluice's own dir_session_name.
[[ "$name" =~ ^(.+)\+([0-9]+)$ ]] && name="${BASH_REMATCH[1]}_${BASH_REMATCH[2]}"
# A leading dash would read as a flag; sluice's own names never start with one.
name="${name/#-/_}"
printf '%s\t%s\n' "$name" "$selected"
